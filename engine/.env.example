# Kosmographica engine configuration (copy to .env). All vars are KGE_-prefixed.

# --- Database -----------------------------------------------------------------
# Local dev uses the Dockerized pgvector on port 5459 (see docker-compose.yml).
KGE_DATABASE_URL=postgresql+psycopg://kosmo:kosmo@localhost:5459/kosmographica

# Lowest trust tier the public read API surfaces (machine_validated+ are public).
KGE_PUBLIC_MIN_TIER=machine_validated

# --- LLM (provider-agnostic, Wave 2) ------------------------------------------
# Author + verifier call a thin LLMClient. No provider is pinned.
#   fake    deterministic, offline; used by tests/CI (default)
#   ollama  local daemon; set KGE_LLM_MODEL / KGE_LLM_BASE_URL
#   openai  any OpenAI-compatible API; set KGE_LLM_API_KEY (+ optional base url)
KGE_LLM_PROVIDER=fake
KGE_LLM_MODEL=
KGE_LLM_BASE_URL=
KGE_LLM_API_KEY=
KGE_LLM_TIMEOUT_S=60

# Entailment acceptance threshold for the publish-then-verify gate.
KGE_VERIFY_ACCEPT_THRESHOLD=0.6

# --- Embeddings (DEFERRED to Wave 3) ------------------------------------------
# Retrieval is keyword/graph-based in Wave 2; a pgvector backend is a Wave 3 drop-in.
KGE_EMBEDDING_PROVIDER=none
